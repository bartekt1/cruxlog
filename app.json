{
  "expo": {
    "name": "Cruxlog",
    "slug": "cruxlog",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.cruxlog"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.cruxlog"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "cruxlog",
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-localization",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Cruxlog uses your location to show it on the map and suggest nearby crags. It never leaves your device."
        }
      ]
    ]
  }
}
