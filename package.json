{
  "name": "cruxlog",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-community/datetimepicker": "9.1.0",
    "expo": "~57.0.27",
    "expo-constants": "~57.0.21",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.12",
    "expo-localization": "~57.0.2",
    "expo-location": "~57.0.20",
    "expo-router": "~57.0.25",
    "expo-sharing": "~57.0.22",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "i18next": "^26.4.2",
    "papaparse": "^5.7.0",
    "react": "19.2.3",
    "react-i18next": "^17.0.16",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "^15.15.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "~19.2.2",
    "babel-jest": "^29.7.0",
    "babel-preset-expo": "^57.0.14",
    "jest": "^29.7.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "lint": "expo lint"
  },
  "private": true,
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "transform": {
      "^.+\\.tsx?$": [
        "babel-jest",
        {
          "presets": [
            "babel-preset-expo"
          ]
        }
      ]
    }
  }
}
